                    AppVersion="0.3.0" Description="Join the Plasma editor's USD live sessions from 3ds Max."
                    Author="Plasma Engine" ProductCode="{6E3A1C52-8B0F-4D1E-A7C4-3F2B9D5E8A10}"
                    UpgradeCode="{6E3A1C52-8B0F-4D1E-A7C4-3F2B9D5E8A11}">
  <CompanyDetails Name="Plasma Engine" />
  <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2024" />
  <Components Description="pre-start-up scripts parts">
    <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2024" />
    <ComponentEntry Name="Plasma menu" AppName="PlasmaUsdLiveMenu" Version="0.3.0"
                    ModuleName="./Contents/startup/plasma_usd_live_menu.ms" />
  </Components>
  <Components Description="post-start-up scripts parts">
    <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2024" />
    <ComponentEntry Name="Plasma USD Live" AppName="PlasmaUsdLive" Version="0.3.0"
                    ModuleName="./Contents/startup/plasma_usd_live.ms" />
  </Components>
</ApplicationPackage>
