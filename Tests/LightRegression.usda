#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "World"
{
    custom string unrealAssetPath = "/Game/LightRegression"

    def RectLight "Panel"
    {
        float inputs:width = 100
        float inputs:height = 200
        float inputs:intensity = 2
        color3f inputs:color = (0.2, 0.5, 1)

        def Xform "Marker"
        {
            double3 xformOp:translate = (0, 0, -100)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def DiskLight "Disk"
    {
        float inputs:radius = 50
        float inputs:intensity = 2
    }

    def Camera "Camera"
    {
    }

    def SphereLight "Point"
    {
        float inputs:radius = 0
        float inputs:intensity = 100
    }

    def SphereLight "Spot" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:radius = 50
        float inputs:intensity = 100
        float inputs:shaping:cone:angle = 30
    }
}
