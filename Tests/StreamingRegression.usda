#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Root"
{
    def Scope "Materials"
    {
        def Material "Red"
        {
            token outputs:surface.connect = </Root/Materials/Red/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                token outputs:surface
            }
        }
        def Material "Blue"
        {
            token outputs:surface.connect = </Root/Materials/Blue/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 1)
                token outputs:surface
            }
        }
    }
    def Mesh "A" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        variants = { string shape = "small" }
        prepend variantSets = "shape"
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </Root/Materials/Red>
        variantSet "shape" = {
            "small" {
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }
            "large" {
                point3f[] points = [(0, 0, 0), (2, 0, 0), (0, 2, 0)]
            }
        }
    }
    def Mesh "B" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </Root/Materials/Blue>
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
